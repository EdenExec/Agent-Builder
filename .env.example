# Copy to .env for local runs. In a Claude cloud environment, set these as
# environment variables in the environment's settings instead.

# Anthropic (required for the employee itself; organisation needs Managed Agents beta)
ANTHROPIC_API_KEY=

# Image sources for vision boards.
# Openverse and Wikimedia Commons need no key.
# Unsplash: https://unsplash.com/oauth/applications  -> New Application -> "Access Key"
UNSPLASH_ACCESS_KEY=
# Pexels: https://www.pexels.com/api/  -> "Get Started" -> key is shown immediately
PEXELS_API_KEY=
