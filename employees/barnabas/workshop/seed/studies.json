    "title": "Romans 5 to 8: Life in the Spirit",
    "summary": "Four chapters from peace with God to no condemnation, the Spirit's life and the unbreakable love of God. It follows your reading spine and moves slowly where the gospel is richest.",
    "sessions": [
      {
        "n": 1,
        "title": "Peace with God",
        "read": "Romans 5:1-11",
        "focus": "Justification, peace, hope"
      },
      {
        "n": 2,
        "title": "Adam and Christ",
        "read": "Romans 5:12-21",
        "focus": "Two heads, one gift"
      },
      {
        "n": 3,
        "title": "Dead to sin, alive to God",
        "read": "Romans 6",
        "focus": "Union with Christ and baptism"
      },
      {
        "n": 4,
        "title": "The struggle and the Spirit",
        "read": "Romans 7:7-8:17",
        "focus": "Law, flesh, Spirit, adoption"
      },
      {
        "n": 5,
        "title": "Nothing can separate",
        "read": "Romans 8:18-39",
        "focus": "Groaning, glory, God's love"
      }
    ],
